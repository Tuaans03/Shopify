{% if section.settings.show_announcement %}
  <div class="announcement" role="region" aria-label="Announcement">
    <div class="announcement__inner page-width">
      {% if section.settings.link != blank %}<a class="announcement__link" href="{{ section.settings.link }}">{% endif %}
        <p class="announcement__text">{{ section.settings.text | escape }}</p>
      {% if section.settings.link != blank %}</a>{% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "New graphic tees are here — made on demand for your rotation" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
