<section class="blog-page page-width">
  <p class="section-eyebrow">Journal</p>
  <h1 class="page-title">{{ blog.title | escape }}</h1>
  {% paginate blog.articles by section.settings.articles_per_page %}
    <div class="article-grid">
      {% for article in blog.articles %}
        <article class="article-card">
          {% if article.image %}
            <a class="article-card__image" href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: article.image.alt }}</a>
          {% endif %}
          <p class="article-card__meta">{{ article.published_at | date: '%B %d, %Y' }} · {{ article.author | escape }}</p>
          <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
          <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
        </article>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [{ "type": "range", "id": "articles_per_page", "min": 6, "max": 24, "step": 3, "label": "Articles per page", "default": 9 }]
}
{% endschema %}
