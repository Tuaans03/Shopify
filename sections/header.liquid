{% liquid
  assign logo_width_2x = section.settings.logo_width | times: 2
  assign brand_name = settings.brand_name | default: shop.name
  assign navigation_menu = section.settings.menu

  assign new_arrivals_collection = section.settings.new_arrivals_collection | default: collections['new-arrivals']
  assign best_sellers_collection = section.settings.best_sellers_collection | default: collections['best-sellers']
  assign t_shirts_collection = section.settings.t_shirts_collection | default: collections['t-shirts']
  assign sweatshirts_collection = section.settings.sweatshirts_collection | default: collections['sweatshirts']
  assign gildan_collection = section.settings.gildan_collection | default: collections['gildan']
  assign bella_canvas_collection = section.settings.bella_canvas_collection | default: collections['bella-canvas']

  assign new_arrivals_url = '/collections/new-arrivals'
  assign best_sellers_url = '/collections/best-sellers'
  assign t_shirts_url = '/collections/t-shirts'
  assign sweatshirts_url = '/collections/sweatshirts'
  assign gildan_url = '/collections/gildan'
  assign bella_canvas_url = '/collections/bella-canvas'
  assign contact_url = '/pages/contact'

  if new_arrivals_collection != blank
    assign new_arrivals_url = new_arrivals_collection.url
  endif
  if best_sellers_collection != blank
    assign best_sellers_url = best_sellers_collection.url
  endif
  if t_shirts_collection != blank
    assign t_shirts_url = t_shirts_collection.url
  endif
  if sweatshirts_collection != blank
    assign sweatshirts_url = sweatshirts_collection.url
  endif
  if gildan_collection != blank
    assign gildan_url = gildan_collection.url
  endif
  if bella_canvas_collection != blank
    assign bella_canvas_url = bella_canvas_collection.url
  endif
  if pages['contact'] != blank
    assign contact_url = pages['contact'].url
  endif
%}

<header class="site-header">
  <div class="site-header__inner page-width">
    <a class="site-logo" href="{{ routes.root_url }}" aria-label="{{ brand_name | escape }} home">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo
          | image_url: width: logo_width_2x
          | image_tag: width: section.settings.logo_width, alt: brand_name, preload: true
        }}
      {% else %}
        <span>{{ brand_name | escape }}</span><span class="site-logo__dot">.</span>
      {% endif %}
    </a>

    <form class="header-search-bar" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">Search products</label>
      <input
        id="HeaderSearch-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.search_placeholder | escape }}"
        autocomplete="off"
      >
      <button type="submit">Search</button>
    </form>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {% if navigation_menu != blank and navigation_menu.links != blank %}
        {% for link in navigation_menu.links %}
          {% if link.links != blank %}
            <details class="desktop-nav__dropdown{% if link.current or link.child_active %} is-active{% endif %}">
              <summary>{{ link.title | escape }}</summary>
              <div class="desktop-nav__dropdown-panel">
                <div class="desktop-nav__dropdown-surface">
                  {% unless link.url == blank or link.url == '#' %}
                    <a class="desktop-nav__dropdown-all" href="{{ link.url }}">Shop all {{ link.title | escape }}</a>
                  {% endunless %}
                  {% for child_link in link.links %}
                    <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                  {% endfor %}
                </div>
              </div>
            </details>
          {% else %}
            <a class="desktop-nav__link{% if link.current %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a class="desktop-nav__link{% if request.path == routes.root_url %} is-active{% endif %}" href="{{ routes.root_url }}"{% if request.path == routes.root_url %} aria-current="page"{% endif %}>Home</a>
        <a class="desktop-nav__link{% if request.path == routes.all_products_collection_url %} is-active{% endif %}" href="{{ routes.all_products_collection_url }}"{% if request.path == routes.all_products_collection_url %} aria-current="page"{% endif %}>Shop</a>
        <a class="desktop-nav__link{% if request.path == new_arrivals_url %} is-active{% endif %}" href="{{ new_arrivals_url }}"{% if request.path == new_arrivals_url %} aria-current="page"{% endif %}>New arrivals</a>
        <a class="desktop-nav__link{% if request.path == best_sellers_url %} is-active{% endif %}" href="{{ best_sellers_url }}"{% if request.path == best_sellers_url %} aria-current="page"{% endif %}>Best sellers</a>
        <details class="desktop-nav__dropdown{% if request.path == t_shirts_url or request.path == gildan_url or request.path == bella_canvas_url %} is-active{% endif %}">
          <summary>T-Shirts</summary>
          <div class="desktop-nav__dropdown-panel">
            <div class="desktop-nav__dropdown-surface">
              <a class="desktop-nav__dropdown-all" href="{{ t_shirts_url }}"{% if request.path == t_shirts_url %} aria-current="page"{% endif %}>Shop all T-Shirts</a>
              <a href="{{ gildan_url }}"{% if request.path == gildan_url %} aria-current="page"{% endif %}>Gildan</a>
              <a href="{{ bella_canvas_url }}"{% if request.path == bella_canvas_url %} aria-current="page"{% endif %}>Bella Canvas</a>
            </div>
          </div>
        </details>
        <a class="desktop-nav__link{% if request.path == sweatshirts_url %} is-active{% endif %}" href="{{ sweatshirts_url }}"{% if request.path == sweatshirts_url %} aria-current="page"{% endif %}>Sweatshirts</a>
        <a class="desktop-nav__link{% if request.path == contact_url %} is-active{% endif %}" href="{{ contact_url }}"{% if request.path == contact_url %} aria-current="page"{% endif %}>Contact</a>
      {% endif %}
    </nav>

    <details class="mobile-nav" scroll-lock>
      <summary class="mobile-nav__summary" aria-label="Open menu">Menu</summary>
      <div class="mobile-nav__panel">
        <nav class="mobile-nav__links" aria-label="Mobile navigation">
          {% if navigation_menu != blank and navigation_menu.links != blank %}
            {% for link in navigation_menu.links %}
              {% if link.links != blank %}
                <details class="mobile-nav__group">
                  <summary>{{ link.title | escape }}</summary>
                  <div>
                    {% unless link.url == blank or link.url == '#' %}<a href="{{ link.url }}">Shop all {{ link.title | escape }}</a>{% endunless %}
                    {% for child_link in link.links %}<a href="{{ child_link.url }}">{{ child_link.title | escape }}</a>{% endfor %}
                  </div>
                </details>
              {% else %}
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {% endif %}
            {% endfor %}
          {% else %}
            <a href="{{ routes.root_url }}"{% if request.path == routes.root_url %} aria-current="page"{% endif %}>Home</a>
            <a href="{{ routes.all_products_collection_url }}"{% if request.path == routes.all_products_collection_url %} aria-current="page"{% endif %}>Shop</a>
            <a href="{{ new_arrivals_url }}"{% if request.path == new_arrivals_url %} aria-current="page"{% endif %}>New arrivals</a>
            <a href="{{ best_sellers_url }}"{% if request.path == best_sellers_url %} aria-current="page"{% endif %}>Best sellers</a>
            <details class="mobile-nav__group"{% if request.path == t_shirts_url or request.path == gildan_url or request.path == bella_canvas_url %} open{% endif %}>
              <summary>T-Shirts</summary>
              <div>
                <a href="{{ t_shirts_url }}"{% if request.path == t_shirts_url %} aria-current="page"{% endif %}>Shop all T-Shirts</a>
                <a href="{{ gildan_url }}"{% if request.path == gildan_url %} aria-current="page"{% endif %}>Gildan</a>
                <a href="{{ bella_canvas_url }}"{% if request.path == bella_canvas_url %} aria-current="page"{% endif %}>Bella Canvas</a>
              </div>
            </details>
            <a href="{{ sweatshirts_url }}"{% if request.path == sweatshirts_url %} aria-current="page"{% endif %}>Sweatshirts</a>
            <a href="{{ contact_url }}"{% if request.path == contact_url %} aria-current="page"{% endif %}>Contact</a>
          {% endif %}
        </nav>
        <div class="mobile-nav__secondary">
          <a href="{{ routes.search_url }}">Search</a>
          {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Account</a>{% endif %}
        </div>
      </div>
    </details>

    <div class="header-actions">
      {% if shop.customer_accounts_enabled %}
        <a class="header-action header-action--account" href="{{ routes.account_url }}" aria-label="Account">{{ 'icon-account.svg' | inline_asset_content }}</a>
      {% endif %}

      <a class="header-action" href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}<span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 80, "max": 240, "step": 10, "unit": "px", "label": "Logo width", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Shopify navigation menu", "info": "Optional. Leave blank to use the simplified store navigation." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search graphic tees, styles, and collections" },
    { "type": "header", "content": "Simplified navigation collections" },
    { "type": "collection", "id": "new_arrivals_collection", "label": "New arrivals" },
    { "type": "collection", "id": "best_sellers_collection", "label": "Best sellers" },
    { "type": "collection", "id": "t_shirts_collection", "label": "T-Shirts" },
    { "type": "collection", "id": "sweatshirts_collection", "label": "Sweatshirts" },
    { "type": "collection", "id": "gildan_collection", "label": "Gildan filter collection" },
    { "type": "collection", "id": "bella_canvas_collection", "label": "Bella Canvas filter collection" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
