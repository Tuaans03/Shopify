<section class="cart-page page-width">
  <h1 class="page-title">Your cart</h1>

  {% if cart.item_count == 0 %}
    <div class="empty-cart">
      <h2>Nothing here yet.</h2>
      <p>Your next favorite graphic tee is waiting.</p>
      <a class="button button--accent" href="{{ routes.all_products_collection_url }}">Shop all tees</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cart-layout">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">
                {% if item.image %}
                  {{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180, 260, 360', sizes: '130px', alt: item.image.alt }}
                {% else %}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </a>
              <div>
                <h2 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                {% unless item.product.has_only_default_variant %}<p class="cart-item__meta">{{ item.variant.title | escape }}</p>{% endunless %}
                {% for property in item.properties %}
                  {% assign property_first_character = property.first | slice: 0 %}
                  {% if property.last != blank and property_first_character != '_' %}
                    <p class="cart-item__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                  {% endif %}
                {% endfor %}
                {% for discount in item.line_level_discount_allocations %}<p class="cart-item__meta">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}
                <a class="cart-item__remove" href="{{ item.url_to_remove }}">Remove</a>
              </div>
              <div class="cart-item__price">
                <label class="field-label" for="CartQuantity-{{ forloop.index }}">Quantity</label>
                <input id="CartQuantity-{{ forloop.index }}" type="number" name="updates[]" min="0" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title | escape }}">
                <div class="price">
                  <span>{{ item.final_line_price | money }}</span>
                  {% if item.original_line_price > item.final_line_price %}<s class="price__compare">{{ item.original_line_price | money }}</s>{% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <aside class="cart-summary">
          <h2 class="cart-summary__title">Order summary</h2>
          {% for discount in cart.cart_level_discount_applications %}
            <div class="cart-summary__line"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {% endfor %}
          <div class="cart-summary__line"><span>Subtotal</span><span>{{ cart.total_price | money_with_currency }}</span></div>
          <p class="cart-summary__note">Taxes and shipping are calculated at checkout.</p>
          <label class="field-label" for="CartNote">Order note</label>
          <textarea id="CartNote" name="note" placeholder="Anything we should know?">{{ cart.note }}</textarea>
          <button class="button button--outline button--full" type="submit" name="update">Update cart</button>
          <button class="button button--accent button--full" type="submit" name="checkout">Secure checkout</button>
        </aside>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
