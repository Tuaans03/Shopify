<article class="article-page page-width">
  <div class="article-page__inner">
    {% if article.image %}<div class="article-page__image">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: 'min(800px, 100vw)', alt: article.image.alt }}</div>{% endif %}
    <p class="section-eyebrow">{{ article.published_at | date: '%B %d, %Y' }} · {{ article.author | escape }}</p>
    <h1 class="page-title">{{ article.title | escape }}</h1>
    <div class="rte">{{ article.content }}</div>

    {% if blog.comments_enabled? %}
      <section id="comments" class="section--tight">
        <h2>Comments</h2>
        {% paginate article.comments by 10 %}
          {% for comment in article.comments %}<div class="rte"><strong>{{ comment.author | escape }}</strong><p>{{ comment.content }}</p></div>{% endfor %}
          {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination: anchor: 'comments' }}</div>{% endif %}
        {% endpaginate %}
        {% form 'new_comment', article %}
          <h2>Leave a comment</h2>
          {{ form.errors | default_errors }}
          <label for="CommentAuthor">Name</label><input id="CommentAuthor" type="text" name="comment[author]" value="{{ form.author }}" required>
          <label for="CommentEmail">Email</label><input id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" required>
          <label for="CommentBody">Comment</label><textarea id="CommentBody" name="comment[body]" required>{{ form.body }}</textarea>
          <button class="button button--accent" type="submit">Post comment</button>
        {% endform %}
      </section>
    {% endif %}
  </div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
