<section class="collection-showcase section">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__copy">
        {% if section.settings.eyebrow != blank %}<p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.text != blank %}<p class="section-subtitle">{{ section.settings.text | escape }}</p>{% endif %}
      </div>
      <a class="text-link" href="{{ routes.collections_url }}">View all collections →</a>
    </div>

    <div class="collection-grid collection-grid--hierarchy">
      {% assign configured_collections = 0 %}
      {% for block in section.blocks %}
        {% assign tile_collection = block.settings.collection %}
        {% if tile_collection != blank %}
          {% unless tile_collection.handle == 'gildan' or tile_collection.handle == 'bella-canvas' %}
            {% assign configured_collections = configured_collections | plus: 1 %}
            {% assign tile_image = block.settings.image | default: tile_collection.image | default: tile_collection.products.first.featured_image %}
            <a class="collection-tile" href="{{ tile_collection.url }}" {{ block.shopify_attributes }}>
              {% if tile_image != blank %}
                {{ tile_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 1100px) 50vw, (min-width: 560px) 50vw, 80vw', alt: tile_collection.title }}
              {% else %}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              <div class="collection-tile__content">
                <h3 class="collection-tile__title">{{ tile_collection.title | escape }}</h3>
                <p class="collection-tile__count">{{ tile_collection.products_count }} products</p>
              </div>
            </a>
          {% endunless %}
        {% endif %}
      {% endfor %}

      {% if configured_collections == 0 %}
        {% assign top_level_collections_shown = 0 %}
        {% for tile_collection in collections %}
          {% unless tile_collection.handle == 'gildan' or tile_collection.handle == 'bella-canvas' %}
            {% if top_level_collections_shown < 4 %}
              {% assign tile_image = tile_collection.image | default: tile_collection.products.first.featured_image %}
              <a class="collection-tile" href="{{ tile_collection.url }}">
                {% if tile_image != blank %}
                  {{ tile_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 1100px) 50vw, (min-width: 560px) 50vw, 80vw', alt: tile_collection.title }}
                {% else %}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
                <div class="collection-tile__content">
                  <h3 class="collection-tile__title">{{ tile_collection.title | escape }}</h3>
                  <p class="collection-tile__count">{{ tile_collection.products_count }} products</p>
                </div>
              </a>
              {% assign top_level_collections_shown = top_level_collections_shown | plus: 1 %}
            {% endif %}
          {% endunless %}
        {% else %}
          {% if request.design_mode %}<div class="empty-state">Create collections or select them in this section to populate the grid.</div>{% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your thing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by vibe" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Fresh artwork for every kind of personality, obsession, and everyday mood." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom cover image" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Collection showcase", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
