{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections['all']
  endif
%}

<section class="section{% if section.settings.compact %} section--tight{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__copy">
        {% if section.settings.eyebrow != blank %}<p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="section-title">{{ section.settings.heading | default: featured_collection.title | escape }}</h2>
        {% if section.settings.text != blank %}<p class="section-subtitle">{{ section.settings.text | escape }}</p>{% endif %}
      </div>
      {% if featured_collection != blank %}<a class="text-link" href="{{ featured_collection.url }}">Shop the collection →</a>{% endif %}
    </div>

    <div class="product-grid">
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product, collection: featured_collection, show_vendor: section.settings.show_vendor %}
      {% else %}
        {% if request.design_mode %}
          <div class="empty-state">Select a collection with products. This section never creates mock products.</div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Most wanted" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Current favorites" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The designs customers keep coming back for." },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 4, "label": "Products to show", "default": 8 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "compact", "label": "Use compact spacing", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
