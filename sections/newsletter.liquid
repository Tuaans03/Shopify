<section class="newsletter section">
  <div class="newsletter__inner page-width">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="newsletter__title">{{ section.settings.heading | escape }}</h2>
      <p class="newsletter__text">{{ section.settings.text | escape }}</p>
    </div>
    <div>
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
        <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" placeholder="Your email address" required>
        <button class="button" type="submit">{{ section.settings.button_label | escape }}</button>
        {% if form.posted_successfully? %}<p class="form-message">Thanks — you're on the list.</p>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No spam. Just good shirts." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the next drop first." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join for new art, limited collections, and the occasional inbox-only offer." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
