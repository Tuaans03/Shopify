<section class="section page-width">
  <div class="contact-layout">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 class="section-title">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}<div class="section-subtitle rte">{{ section.settings.text }}</div>{% endif %}
    </div>

    {% form 'contact', class: 'contact-form' %}
      {% if form.posted_successfully? %}<p class="form-message" tabindex="-1">Thanks for reaching out. We’ll get back to you as soon as we can.</p>{% endif %}
      {{ form.errors | default_errors }}

      <div class="contact-form__row">
        <div>
          <label class="field-label" for="ContactName-{{ section.id }}">Name</label>
          <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name">
        </div>
        <div>
          <label class="field-label" for="ContactEmail-{{ section.id }}">Email</label>
          <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>
      </div>
      <label class="field-label" for="ContactOrder-{{ section.id }}">Order number (optional)</label>
      <input id="ContactOrder-{{ section.id }}" type="text" name="contact[order_number]" value="{{ form.order_number }}">
      <label class="field-label" for="ContactMessage-{{ section.id }}">How can we help?</label>
      <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" required>{{ form.body }}</textarea>
      <button class="button button--accent" type="submit">Send message</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We’re here to help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let’s talk." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an order, a size, or a design? Send a note and include your order number if you have one.</p>" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
